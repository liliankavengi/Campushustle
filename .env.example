# CampusHustle - Environment Configuration Template

# Next.js App URL (Set automatically by Vercel in production or use custom domain)
NEXT_PUBLIC_APP_URL=https://campushustle.vercel.app

# PayHero Kenya Payment Gateway Credentials (https://payhero.co.ke)
# 1. Sign up on https://payhero.co.ke
# 2. Go to Settings > API Keys to generate your API Key and API Secret
# 3. Under Payment Channels, link your Paybill, Till (Buy Goods), or M-Pesa Phone Number
PAYHERO_API_KEY=your_payhero_api_key
PAYHERO_API_SECRET=your_payhero_api_secret
PAYHERO_CHANNEL_ID=your_payment_channel_id
PAYHERO_CALLBACK_URL=https://campushustle.vercel.app/api/payhero/callback

# Super Admin Email
NEXT_PUBLIC_ADMIN_EMAIL=liliankavengi502@gmail.com
